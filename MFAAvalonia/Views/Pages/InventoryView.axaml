<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             x:Class="MFAAvalonia.Views.Pages.InventoryView" x:CompileBindings="False" FontSize="14">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="Button.pill">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="11,2" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiControlBorderBrush}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.pill.active">
      <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="20,16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="12">
    <!-- 顶栏：标题 + 快照时间 + 操作按钮 -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="仓库资源" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="SnapshotText" Text="尚未采集仓库资源" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="CollectButton" Classes="tool" Click="OnCollect">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <fluent:FluentIcon Icon="Play" IconSize="Size16" VerticalAlignment="Center" />
            <TextBlock Text="开始识别" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="StopButton" Classes="tool" IsVisible="False" IsEnabled="False" Click="OnStop">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <fluent:FluentIcon Icon="Stop" IconSize="Size16" VerticalAlignment="Center" />
            <TextBlock Text="停止" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="CompareButton" Classes="tool" Click="OnOpenComparison">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <fluent:FluentIcon Icon="History" IconSize="Size16" VerticalAlignment="Center" />
            <TextBlock Text="历史对比" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Click="OnRefresh" ToolTip.Tip="刷新仓库数据">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <fluent:FluentIcon Icon="ArrowSync" IconSize="Size16" VerticalAlignment="Center" />
            <TextBlock Text="刷新" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="ExportButton" Classes="tool">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <fluent:FluentIcon Icon="Save" IconSize="Size16" VerticalAlignment="Center" />
            <TextBlock Text="导出" VerticalAlignment="Center" />
            <fluent:FluentIcon Icon="ChevronDown" IconSize="Size16" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout>
              <Border Background="{DynamicResource SukiCardBackground}" Padding="10" CornerRadius="8">
                <StackPanel Spacing="6" MinWidth="160">
                  <Button Content="导出全部 JSON…" HorizontalAlignment="Stretch" Click="OnExportJson" />
                  <Button Content="导出全部 Markdown…" HorizontalAlignment="Stretch" Click="OnExportMarkdown" />
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <!-- 状态提示条（无提示时不占空间） -->
    <Border Grid.Row="1" x:Name="StatusBanner" IsVisible="False" Background="#1D16A34A" BorderBrush="#5016A34A"
            BorderThickness="1" CornerRadius="10" Padding="12,8">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <fluent:FluentIcon Icon="Info" IconSize="Size16" Foreground="#16A34A" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" FontSize="12" Foreground="#16A34A" TextWrapping="Wrap" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- 零维护 Lv90 通用养成估算 + 核心资产 4 格 Bento 总览 -->
    <StackPanel Grid.Row="2" Spacing="8">
      <ItemsControl x:Name="CurrencyCards">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Margin="0,0,8,0">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBlock Text="{Binding Name}" FontSize="12" Opacity="0.68" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="1" CornerRadius="6" Padding="6,2" Background="#24AD833E" IsVisible="{Binding HasSubText}">
                    <TextBlock Text="{Binding SubText}" FontSize="11" FontWeight="SemiBold" Foreground="#C2964E" />
                  </Border>
                </Grid>
                <TextBlock Text="{Binding Quantity}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border x:Name="Lv90Banner" IsVisible="False" Background="#180284C7" BorderBrush="#440284C7"
              BorderThickness="1" CornerRadius="10" Padding="12,7">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <fluent:FluentIcon Icon="Info" IconSize="Size16" Foreground="#0284C7" VerticalAlignment="Center" />
          <TextBlock x:Name="Lv90Text" FontSize="12" Foreground="#0284C7" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- 历史对比控制台（仅对比态显示） -->
    <Border Grid.Row="3" x:Name="ComparisonPanel" Classes="card" IsVisible="False">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <fluent:FluentIcon Icon="History" IconSize="Size16" VerticalAlignment="Center" />
            <TextBlock Text="历史快照对比" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <WrapPanel Grid.Column="1" VerticalAlignment="Center">
            <ComboBox x:Name="HistorySelector" Width="280" MaxDropDownHeight="260" PlaceholderText="选择历史快照" Margin="0,0,6,0"
                      SelectionChanged="OnHistorySelectionChanged" />
            <Button x:Name="RenameSnapshotButton" Classes="tool" Margin="0,0,6,0" Click="OnRenameSnapshot" ToolTip.Tip="重命名所选快照">
              <fluent:FluentIcon Icon="Edit" IconSize="Size16" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="DeleteSnapshotButton" Classes="tool" Margin="0,0,8,0" Click="OnDeleteSnapshot" ToolTip.Tip="删除所选快照">
              <fluent:FluentIcon Icon="Delete" IconSize="Size16" Foreground="#EF4444" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="RunComparisonButton" Classes="tool" Margin="0,0,8,0" Click="OnCompare">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <fluent:FluentIcon Icon="Play" IconSize="Size16" VerticalAlignment="Center" />
                <TextBlock Text="开始对比" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <CheckBox x:Name="ChangesOnly" Content="只看变更" FontSize="12" VerticalAlignment="Center" IsCheckedChanged="OnChangesOnlyChanged" />
          </WrapPanel>
          <Button Grid.Column="2" Classes="tool" Click="OnCloseComparison">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <fluent:FluentIcon Icon="Dismiss" IconSize="Size16" VerticalAlignment="Center" />
              <TextBlock Text="退出对比" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
        <StackPanel x:Name="RenamePanel" IsVisible="False" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBox x:Name="RenameBox" Width="260" Height="32" MinHeight="32" FontSize="12" MaxLength="40"
                   Watermark="自定义快照名称（留空恢复文件名）" />
          <Button Classes="tool" Click="OnConfirmRename">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <fluent:FluentIcon Icon="Checkmark" IconSize="Size16" VerticalAlignment="Center" />
              <TextBlock Text="保存名称" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Click="OnCancelRename">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <fluent:FluentIcon Icon="Dismiss" IconSize="Size16" VerticalAlignment="Center" />
              <TextBlock Text="取消" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel x:Name="DeleteConfirmPanel" IsVisible="False" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock x:Name="DeleteConfirmText" FontSize="12" Foreground="#EF4444" VerticalAlignment="Center" />
          <Button Classes="tool" Click="OnConfirmDelete">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <fluent:FluentIcon Icon="Delete" IconSize="Size16" Foreground="#EF4444" VerticalAlignment="Center" />
              <TextBlock Text="确认删除" Foreground="#EF4444" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Click="OnCancelDelete">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <fluent:FluentIcon Icon="Dismiss" IconSize="Size16" VerticalAlignment="Center" />
              <TextBlock Text="取消" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <TextBlock x:Name="ComparisonText" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- 筛选栏：搜索 + 稀有度胶囊 + 计数 -->
    <Border Grid.Row="4" Classes="card" Padding="12,8">
      <Grid ColumnDefinitions="240,*,Auto" ColumnSpacing="12">
        <TextBox x:Name="SearchBox" Height="32" MinHeight="32" FontSize="12" Watermark="搜索材料或道具名称"
                 TextChanged="OnSearchChanged">
          <TextBox.InnerLeftContent>
            <fluent:FluentIcon Icon="Search" IconSize="Size16" Margin="8,0,0,0" Opacity="0.55" />
          </TextBox.InnerLeftContent>
        </TextBox>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="RarityAllBtn" Classes="pill active" Content="全部" Tag="全部" Click="OnRarityClick" />
          <Button x:Name="RarityGoldBtn" Classes="pill" Content="狂" Tag="狂" Click="OnRarityClick" />
          <Button x:Name="RarityPurpleBtn" Classes="pill" Content="危" Tag="危" Click="OnRarityClick" />
          <Button x:Name="RarityBlueBtn" Classes="pill" Content="普" Tag="普" Click="OnRarityClick" />
        </StackPanel>
        <TextBlock Grid.Column="2" x:Name="FilteredCountText" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- 物品卡片网格 -->
    <Grid Grid.Row="5">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="ItemsCards">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="148" MinHeight="146" Padding="10,10" Margin="0,0,10,10" CornerRadius="12"
                      Background="{DynamicResource SukiCardBackground}"
                      BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="1"
                      ToolTip.Tip="{Binding Name}">
                <Grid>
                  <Ellipse Width="7" Height="7" Fill="{Binding RarityDotBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                  <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                    <Border Width="52" Height="52" CornerRadius="10" Background="#14808080"
                            BorderBrush="#22808080" BorderThickness="1" HorizontalAlignment="Center">
                      <Grid>
                        <Image Source="{Binding Icon}" Width="44" Height="44" Stretch="Uniform" IsVisible="{Binding HasIcon}" />
                        <fluent:FluentIcon Icon="Box" IconSize="Size24" Opacity="0.55"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding HasNoIcon}" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding Quantity}" FontSize="17" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center" ToolTip.Tip="{Binding Quantity}" />
                    <TextBlock Text="{Binding Name}" FontSize="12" Opacity="0.82" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis" MinHeight="34" TextAlignment="Center" ToolTip.Tip="{Binding Name}" />
                    <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Center"
                            Background="{Binding ChangeBg}" IsVisible="{Binding IsComparison}">
                      <TextBlock Text="{Binding Change}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ChangeFg}" />
                    </Border>
                    <TextBlock Text="{Binding Before}" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                               TextAlignment="Center" IsVisible="{Binding IsComparison}" />
                    <TextBlock Text="{Binding Note}" FontSize="11" Opacity="0.68" TextWrapping="Wrap" TextAlignment="Center"
                               ToolTip.Tip="{Binding Note}" IsVisible="{Binding HasNote}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock x:Name="EmptyText" Text="暂无记录，连接设备后点击“开始识别”。" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Opacity="0.65" TextWrapping="Wrap" Margin="16" />
    </Grid>
  </Grid>
</UserControl>
