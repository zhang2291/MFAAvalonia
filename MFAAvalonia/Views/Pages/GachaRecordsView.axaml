<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             x:Class="MFAAvalonia.Views.Pages.GachaRecordsView" x:CompileBindings="False" FontSize="14">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="Button.seg">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.seg.active">
      <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.pill">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiControlBorderBrush}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.pill.active">
      <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="DataGrid.records">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="RowHeight" Value="34" />
      <Setter Property="ColumnHeaderHeight" Value="32" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="DataGrid.records DataGridCell TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="DataGrid.records DataGridColumnHeader">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="210,*">
    <!-- 左侧池子类型导航 -->
    <Border Grid.Column="0" BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="0,0,1,0" Padding="10,14">
      <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
        <TextBlock Text="池子类型" FontSize="12" Opacity="0.6" Margin="8,0,0,2" />
        <ListBox Grid.Row="1" x:Name="CategoryList" Classes="nav" SelectionChanged="OnCategoryChanged">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem x:Name="DeleteMenuItem" Header="删除当前类型" Click="OnDeleteCategory" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding SubTitle}" FontSize="10" Opacity="0.6" IsVisible="{Binding HasSubTitle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Total}" FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="2" x:Name="AddCategoryButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="tool" Click="OnAddCategory">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <fluent:FluentIcon Icon="Add" IconSize="Size16" VerticalAlignment="Center" />
            <TextBlock Text="新建类型" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Grid.Row="3" Text="右键类型可删除" FontSize="11" Opacity="0.55" Margin="6,2,0,0" />
      </Grid>
    </Border>

    <!-- 右侧主内容区 -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="20,16" Spacing="12">
        <!-- 顶栏：当前类型 + 主操作 -->
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBlock x:Name="CategoryTitle" Text="新角色" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border Grid.Column="1" CornerRadius="9" Padding="3" Background="#14808080" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button x:Name="ModeFastButton" Classes="seg active" Content="快速更新" ToolTip.Tip="遇到已有记录即停" Click="OnModeFast" />
              <Button x:Name="ModeFullButton" Classes="seg" Content="完整补录" ToolTip.Tip="翻完全部记录页" Click="OnModeFull" />
            </StackPanel>
          </Border>
          <Button Grid.Column="2" x:Name="CollectButton" Classes="tool" Click="OnCollect">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <fluent:FluentIcon Icon="Play" IconSize="Size16" VerticalAlignment="Center" />
              <TextBlock Text="开始采集" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" x:Name="ReportButton" Classes="tool" Click="OnOpenReport">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <fluent:FluentIcon Icon="Star" IconSize="Size16" VerticalAlignment="Center" />
              <TextBlock Text="战报长图" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="4" Classes="tool">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <fluent:FluentIcon Icon="Save" IconSize="Size16" VerticalAlignment="Center" />
              <TextBlock Text="导入 / 导出" VerticalAlignment="Center" />
              <fluent:FluentIcon Icon="ChevronDown" IconSize="Size16" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout>
                <Border Background="{DynamicResource SukiCardBackground}" Padding="10" CornerRadius="8">
                  <StackPanel Spacing="6" MinWidth="160">
                    <Button x:Name="ImportButton" Content="导入全部记录 (Excel)…" HorizontalAlignment="Stretch" Click="OnImport" />
                    <Button Content="全部导出为 Excel…" HorizontalAlignment="Stretch" Click="OnExportExcel" />
                    <Button Content="全部导出为 Markdown…" HorizontalAlignment="Stretch" Click="OnExportMarkdown" />
                    <Separator />
                    <Button Content="刷新数据" HorizontalAlignment="Stretch" Click="OnRefresh" />
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
        </Grid>

        <!-- 损坏/跳过行提示条（适配浅/深色主题） -->
        <Border x:Name="SkippedBanner" IsVisible="False" Background="#20D97706" BorderBrush="#55D97706" BorderThickness="1" CornerRadius="10" Padding="12,9">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <fluent:FluentIcon Icon="Alert" IconSize="Size16" Foreground="#D97706" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="SkippedText" Foreground="#D97706" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="2" Content="查看" FontSize="12" Padding="10,3" MinHeight="26" Height="26" Click="OnViewSkipped" />
          </Grid>
        </Border>

        <!-- 采集状态与提示条（适配浅/深色主题） -->
        <Border x:Name="StatusBanner" IsVisible="False" Background="#1D16A34A" BorderBrush="#5016A34A" BorderThickness="1" CornerRadius="10" Padding="12,8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock x:Name="StatusText" Foreground="#16A34A" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" x:Name="StopButton" FontSize="12" Padding="12,3" MinHeight="26" Height="26" IsVisible="False" Click="OnStop">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <fluent:FluentIcon Icon="Stop" IconSize="Size16" VerticalAlignment="Center" />
                <TextBlock Text="停止" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- 6 格统计卡（含 UP 不歪率、期望出UP 与保底进度） -->
        <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="10">
          <Border Classes="card">
            <StackPanel Spacing="2">
              <TextBlock Text="总抽数" FontSize="11" Opacity="0.65" />
              <TextBlock x:Name="TotalText" Text="0" FontSize="24" FontWeight="SemiBold" />
              <TextBlock x:Name="DateRangeText" Text="" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card">
            <StackPanel Spacing="2">
              <TextBlock Text="狂总数" FontSize="11" Opacity="0.65" />
              <TextBlock x:Name="GoldText" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="#AD833E" />
              <TextBlock x:Name="RateText" Text="出狂率 —" FontSize="11" Opacity="0.6" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card">
            <StackPanel Spacing="2">
              <TextBlock Text="平均出狂" FontSize="11" Opacity="0.65" />
              <TextBlock x:Name="AverageText" Text="—" FontSize="24" FontWeight="SemiBold" />
              <TextBlock x:Name="SpreadText" Text="" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Classes="card">
            <StackPanel Spacing="2">
              <TextBlock Text="小保底不歪率" FontSize="11" Opacity="0.65" />
              <TextBlock x:Name="UpRateText" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="#16A34A" />
              <TextBlock x:Name="UpSubText" Text="常驻 / 未知池跳过" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Border Grid.Column="4" Classes="card">
            <StackPanel Spacing="2">
              <TextBlock Text="期望出UP" FontSize="11" Opacity="0.65" />
              <TextBlock x:Name="ExpectedUpText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="#6B7280" />
              <TextBlock x:Name="ExpectedUpSubText" Text="未判定池不纳入计算" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Border Grid.Column="5" Classes="card">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="当前已垫" FontSize="11" Opacity="0.65" />
                <TextBlock x:Name="PityRemainText" Grid.Column="1" Text="" FontSize="11" Opacity="0.6" />
              </Grid>
              <TextBlock x:Name="PityText" Text="0 / 80" FontSize="22" FontWeight="SemiBold" Foreground="#AD833E" />
              <ProgressBar x:Name="PityBar" Minimum="0" Maximum="80" Value="0" Height="6" CornerRadius="3" Foreground="#C2964E" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- 概览双栏：左狂级出货，右间隔分布 + 各卡池小计 -->
        <Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
          <Border Classes="card">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="狂级出货" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="HitsCountText" Grid.Column="1" Text="共 0" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
              </Grid>
              <TextBlock x:Name="NoHitsText" Text="暂无狂级记录" FontSize="12" Opacity="0.6" IsVisible="False" Margin="0,8" />
              <ScrollViewer MaxHeight="290" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HitsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="0,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SukiControlBorderBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                          <Border Width="36" Height="36" CornerRadius="10" Background="#24AD833E" BorderBrush="#66AD833E" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                              <Image Source="{Binding AvatarBitmap}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
                              <TextBlock Text="{Binding Avatar}" Foreground="#AD833E" FontWeight="Bold" FontSize="15"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoAvatar}" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                              <Border CornerRadius="5" Padding="5,1" Background="{Binding UpBg}" IsVisible="{Binding HasUpBadge}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UpText}" FontSize="10" FontWeight="Bold" Foreground="{Binding UpFg}" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Meta}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="{Binding Pulls}" Foreground="{Binding IntervalBrush}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding Note}" FontSize="10" Opacity="0.6" IsVisible="{Binding HasNote}" HorizontalAlignment="Right" />
                            <ProgressBar Minimum="0" Maximum="80" Value="{Binding PullValue}" Width="66" Height="4" CornerRadius="2" Foreground="{Binding IntervalBrush}" IsVisible="{Binding ShowBar}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="各卡池小计" FontSize="14" FontWeight="SemiBold" />
              <ScrollViewer MaxHeight="290" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PoolSummariesList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="0,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SukiControlBorderBrush}">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Pool}" FontSize="13" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="{Binding SummaryText}" FontSize="12" Opacity="0.65" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Grid>

        <!-- 完整明细卡片（搜索 + 卡池 + 稀有度 + 按十连分组） -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <WrapPanel VerticalAlignment="Center">
              <TextBlock Text="完整明细" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,6" />
              <TextBox x:Name="SearchBox" Width="200" Height="30" MinHeight="30" FontSize="12" Watermark="搜索角色 / 卡池" Margin="0,0,8,6" TextChanged="OnFilterChanged">
                <TextBox.InnerLeftContent>
                  <fluent:FluentIcon Icon="Search" IconSize="Size16" Margin="8,0,0,0" Opacity="0.55" />
                </TextBox.InnerLeftContent>
              </TextBox>
              <ComboBox x:Name="PoolBox" Width="170" Height="30" MinHeight="30" FontSize="12" Margin="0,0,8,6" SelectionChanged="OnPoolChanged" />
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,6" VerticalAlignment="Center">
                <Button x:Name="RarityAllBtn" Classes="pill active" Content="全部" Click="OnRarityClick" Tag="全部" />
                <Button x:Name="RarityGoldBtn" Classes="pill" Content="狂" Click="OnRarityClick" Tag="狂" />
                <Button x:Name="RarityPurpleBtn" Classes="pill" Content="危" Click="OnRarityClick" Tag="危" />
                <Button x:Name="RarityBlueBtn" Classes="pill" Content="普" Click="OnRarityClick" Tag="普" />
              </StackPanel>
              <CheckBox x:Name="GroupTenCheck" Content="按十连分组" IsChecked="True" FontSize="12" Margin="0,0,12,6" IsCheckedChanged="OnFilterChanged" />
              <TextBlock x:Name="FilteredCountText" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,0,6" />
            </WrapPanel>

            <!-- 按十连分组视图 -->
            <ItemsControl x:Name="GroupedDetailsList" IsVisible="True">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Expander Margin="0,0,0,6" HorizontalAlignment="Stretch" IsExpanded="False">
                    <Expander.Header>
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{Binding BadgeBg}">
                          <TextBlock Text="{Binding Avatar}" Foreground="{Binding BadgeFg}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding HeaderTitle}" FontSize="13" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding HeaderMeta}" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Dots}" VerticalAlignment="Center">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="3" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Width="8" Height="8" CornerRadius="2" Background="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Rows}" Margin="4,4,4,2">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,3">
                            <Border CornerRadius="5" Padding="6,1" Background="{Binding BadgeBg}">
                              <TextBlock Text="{Binding Rarity}" Foreground="{Binding BadgeFg}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="{Binding NameWeight}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding PullsLabel}" Foreground="{Binding PullsBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 逐条明细表格 -->
            <DataGrid x:Name="DetailsGrid" Classes="records" IsReadOnly="True" AutoGenerateColumns="False" IsVisible="False" MaxHeight="440">
              <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="168" />
                <DataGridTextColumn Header="卡池" Binding="{Binding Pool}" Width="*" MinWidth="120" />
                <DataGridTemplateColumn Header="稀有度" Width="74">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border CornerRadius="5" Padding="7,2" Background="{Binding BadgeBg}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0">
                        <TextBlock Text="{Binding Rarity}" Foreground="{Binding BadgeFg}" FontSize="11" FontWeight="SemiBold" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="角色" Binding="{Binding Name}" Width="*" MinWidth="100" />
                <DataGridTextColumn Header="第几抽出" Binding="{Binding Pulls}" Width="86" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
