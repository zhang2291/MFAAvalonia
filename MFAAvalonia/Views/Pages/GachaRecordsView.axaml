<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MFAAvalonia.Views.Pages.GachaRecordsView" x:CompileBindings="False" FontSize="14">
  <UserControl.Styles>
    <Style Selector="Button.compact">
      <Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="32" />
      <Setter Property="Height" Value="32" /><Setter Property="Padding" Value="12,4" />
      <Setter Property="Margin" Value="0,0,8,6" />
    </Style>
    <Style Selector="ComboBox.compact">
      <Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="32" />
      <Setter Property="Height" Value="32" /><Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,8,6" />
    </Style>
    <Style Selector="DataGrid.records">
      <Setter Property="FontSize" Value="13" /><Setter Property="RowHeight" Value="32" />
      <Setter Property="ColumnHeaderHeight" Value="32" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="DataGrid.records DataGridCell TextBlock">
      <Setter Property="FontSize" Value="13" /><Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="DataGrid.records DataGridColumnHeader">
      <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.stat">
      <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
  </UserControl.Styles>
  <Grid Margin="18,14" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
      <TextBlock Text="抽卡记录" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Grid.Column="1" Text="采集记录自动保存" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
    </Grid>
    <WrapPanel Grid.Row="1">
      <ComboBox x:Name="CategoryBox" Classes="compact" Width="145" SelectionChanged="OnCategoryChanged" ToolTip.Tip="本次采集保存到哪个池子类型">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding name}" FontSize="13" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <Button Classes="compact" Content="＋ 类型" Click="OnAddCategory" />
      <Button x:Name="DeleteCategoryButton" Classes="compact" Content="删除类型" Click="OnDeleteCategory" />
      <ComboBox x:Name="ModeBox" Classes="compact" SelectedIndex="0" Width="155">
        <ComboBoxItem Content="完整识别" /><ComboBoxItem Content="识别到已知停止" />
      </ComboBox>
      <Button x:Name="CollectButton" Classes="compact" Content="开始采集" Click="OnCollect" />
      <Button x:Name="StopButton" Classes="compact" Content="停止" Click="OnStop" IsEnabled="False" />
      <Button Classes="compact" Content="刷新" Click="OnRefresh" />
      <Button Classes="compact" Content="导出 ▾">
        <Button.Flyout><Flyout><Border Background="{DynamicResource SukiCardBackground}" Padding="12" CornerRadius="8"><StackPanel Spacing="6">
          <Button Content="全部导出为 Excel…" Click="OnExportExcel" />
          <Button Content="全部导出为 Markdown…" Click="OnExportMarkdown" />
        </StackPanel></Border></Flyout></Button.Flyout>
      </Button>
      <Button x:Name="ImportButton" Classes="compact" Content="导入全部" Click="OnImport" />
    </WrapPanel>
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="6">
      <WrapPanel>
        <TextBlock Text="查看卡池" FontSize="12" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,10,6" />
        <ComboBox x:Name="PoolBox" Classes="compact" Width="190" SelectionChanged="OnPoolChanged" ToolTip.Tip="只筛选显示和导出的记录，不改变采集范围" />

      </WrapPanel>
      <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
        <Border Classes="stat"><StackPanel Spacing="2"><TextBlock Text="总抽数" FontSize="12" Opacity="0.65" /><TextBlock x:Name="TotalText" Text="—" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
        <Border Grid.Column="1" Classes="stat"><StackPanel Spacing="2"><TextBlock Text="狂总数" FontSize="12" Opacity="0.65" /><TextBlock x:Name="GoldText" Text="—" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
        <Border Grid.Column="2" Classes="stat"><StackPanel Spacing="2"><TextBlock Text="狂平均抽数" FontSize="12" Opacity="0.65" /><TextBlock x:Name="AverageText" Text="—" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="StatusText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
    <TabControl Grid.Row="4" x:Name="RecordTabs" FontSize="14" MinHeight="100">
      <TabItem Header="概览">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10" Margin="0,10,6,0">
            <TextBlock Text="各类型汇总" FontSize="14" FontWeight="SemiBold" />
            <ItemsControl x:Name="CategoryCards">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Classes="stat" Width="168" Margin="0,0,8,8" Padding="12,8">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    <TextBlock Text="{Binding Total, StringFormat='{}{0} 抽'}" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Gold, StringFormat='狂：{0}'}" FontSize="12" Opacity="0.7" />
                    <TextBlock Text="{Binding Average, StringFormat='狂平均抽数：{0}'}" FontSize="12" Opacity="0.7" />
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="狂级出货记录" FontSize="14" FontWeight="SemiBold" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel MinWidth="650" Spacing="0">
                <Grid ColumnDefinitions="2*,165,2*,180" Margin="10,6">
                  <TextBlock Text="角色" FontSize="12" Opacity="0.65" />
                  <TextBlock Grid.Column="1" Text="出货抽数" FontSize="12" Opacity="0.65" />
                  <TextBlock Grid.Column="2" Text="卡池" FontSize="12" Opacity="0.65" />
                  <TextBlock Grid.Column="3" Text="时间" FontSize="12" Opacity="0.65" />
                </Grid>
                <ItemsControl x:Name="HitsList">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SukiControlBorderBrush}">
                      <Grid ColumnDefinitions="2*,165,2*,180" MinHeight="28">
                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Pulls}" FontSize="13" />
                          <TextBlock Text="{Binding Note}" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Pool}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Time}" FontSize="12" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="完整明细">
        <DataGrid x:Name="DetailsGrid" Classes="records" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,8,0,0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="时间" Binding="{Binding Time}" FontSize="13" Width="180" />
            <DataGridTextColumn Header="类型" Binding="{Binding Type}" FontSize="13" Width="90" />
            <DataGridTextColumn Header="卡池" Binding="{Binding Pool}" FontSize="13" Width="*" MinWidth="130" />
            <DataGridTextColumn Header="稀有度" Binding="{Binding Rarity}" FontSize="13" Width="100" />
            <DataGridTextColumn Header="角色" Binding="{Binding Name}" FontSize="13" Width="*" MinWidth="105" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
